 "scen_meta": [
  {
   "key": "h",
   "label": "CITY CODE",
   "unit": "",
   "formula": null
  },
  {
   "key": "m_demand",
   "label": "Спрос на членство",
   "unit": "чел",
   "formula": "{mau}*{conv}+{direct}"
  },
  {
   "key": "m_cap",
   "label": "Потолок по партнёрам (15 на точку)",
   "unit": "чел",
   "formula": "{partners}*{seats_per_partner}"
  },
  {
   "key": "members",
   "label": "Участников",
   "unit": "чел",
   "formula": "ROUND(MIN({m_demand},{m_cap}),0)"
  },
  {
   "key": "founders",
   "label": "  из них «Основатели»",
   "unit": "чел",
   "formula": "MIN({founder_cap},{members})"
  },
  {
   "key": "basic",
   "label": "  из них Basic",
   "unit": "чел",
   "formula": "{members}-{founders}"
  },
  {
   "key": "rev_memb",
   "label": "Выручка членства",
   "unit": "₽/мес",
   "formula": "({founders}*{price_founder}+{basic}*{price_basic})/12"
  },
  {
   "key": "net_turn",
   "label": "Оборот клуба у партнёров (не наш доход)",
   "unit": "₽/мес",
   "formula": "{members}*{spend}"
  },
  {
   "key": "turn_pp",
   "label": "  на одного партнёра",
   "unit": "₽/мес",
   "formula": "{net_turn}/{partners}"
  },
  {
   "key": "h",
   "label": "ДРУГИЕ ДОХОДЫ",
   "unit": "",
   "formula": null
  },
  {
   "key": "rev_pfee",
   "label": "Взнос партнёров v2.0 (если решишь)",
   "unit": "₽/мес",
   "formula": "{partners}*{partner_fee_m}"
  },
  {
   "key": "ad_check",
   "label": "Средний чек размещения",
   "unit": "₽",
   "formula": "MAX({ad_min_post},ROUND({ads_views}*{ad_cpm}/1000,-2))*(1-{ads_partner_share}*{ad_partner_disc})"
  },
  {
   "key": "rev_ads",
   "label": "Реклама SAI",
   "unit": "₽/мес",
   "formula": "{ads_n}*{ad_check}"
  },
  {
   "key": "rev_content",
   "label": "Съёмки",
   "unit": "₽/мес",
   "formula": "{shoots_n}*{shoot_price}"
  },
  {
   "key": "rev_events",
   "label": "События",
   "unit": "₽/мес",
   "formula": "{ev_n}*{ev_people}*{ev_ticket}"
  },
  {
   "key": "rev_merch",
   "label": "Мерч",
   "unit": "₽/мес",
   "formula": "({members}*{mr_members}+{mau}*{mr_mau})*{m_check}"
  },
  {
   "key": "rev_cfa",
   "label": "ЦФА-услуги (среднемесячно)",
   "unit": "₽/мес",
   "formula": "({cfa_rev_n}*80000+{cfa_build_n}*325000)/12"
  },
  {
   "key": "rev_rwa_ads",
   "label": "Реклама YuRichRWA",
   "unit": "₽/мес",
   "formula": "{rwa_subs}*{rwa_view}*{rwa_cpm}/1000*{rwa_posts}"
  },
  {
   "key": "rev_total",
   "label": "ВСЯ ВЫРУЧКА",
   "unit": "₽/мес",
   "formula": "{rev_memb}+{rev_pfee}+{rev_ads}+{rev_content}+{rev_events}+{rev_merch}+{rev_cfa}+{rev_rwa_ads}"
  },
  {
   "key": "rev_year",
   "label": "Выручка за год",
   "unit": "₽/год",
   "formula": "{rev_total}*12"
  },
  {
   "key": "h",
   "label": "РАСХОДЫ",
   "unit": "",
   "formula": null
  },
  {
   "key": "c_ai",
   "label": "AI (Кира)",
   "unit": "₽/мес",
   "formula": "{mau}*{ai_mau}"
  },
  {
   "key": "c_acq",
   "label": "Приём платежей",
   "unit": "₽/мес",
   "formula": "{acq_blend}*({rev_memb}+{rev_events}+{rev_merch})"
  },
  {
   "key": "c_cogs",
   "label": "Себестоимость событий, мерча, съёмок",
   "unit": "₽/мес",
   "formula": "{rev_events}*{ev_cost}+{rev_merch}*{merch_cogs}+{rev_content}*{shoot_cost}"
  },
  {
   "key": "c_adlevy",
   "label": "Сбор 3% с рекламы",
   "unit": "₽/мес",
   "formula": "{ad_levy}*({rev_ads}+{rev_rwa_ads})"
  },
  {
   "key": "c_ipfee",
   "label": "Взносы ИП за себя",
   "unit": "₽/мес",
   "formula": "({ip_fixed}+MAX(0,{rev_year}-{ip_extra_from})*{ip_extra})/12"
  },
  {
   "key": "c_tax",
   "label": "УСН 6% минус взносы",
   "unit": "₽/мес",
   "formula": "MAX(0,{rev_total}*{usn}-{c_ipfee})"
  },
  {
   "key": "c_total",
   "label": "ВСЕ РАСХОДЫ",
   "unit": "₽/мес",
   "formula": "{c_infra}+{c_ai}+{c_team}+{c_mkt}+{c_legal}+{c_ipr}+{c_ipfee}+{c_acq}+{c_cogs}+{c_adlevy}+{c_tax}"
  },
  {
   "key": "h",
   "label": "РЕЗУЛЬТАТ",
   "unit": "",
   "formula": null
  },
  {
   "key": "profit",
   "label": "Прибыль в месяц (без зарплаты основателя)",
   "unit": "₽/мес",
   "formula": "{rev_total}-{c_total}"
  },
  {
   "key": "profit_year",
   "label": "Прибыль за год",
   "unit": "₽/год",
   "formula": "{profit}*12"
  },
  {
   "key": "profit_city",
   "label": "Прибыль города без ЦФА-услуг",
   "unit": "₽/мес",
   "formula": "{profit}-{rev_cfa}*(1-{usn})"
  },
  {
   "key": "profit_city_nofee",
   "label": "  …и без взноса партнёров (строго v1.0)",
   "unit": "₽/мес",
   "formula": "{profit_city}-{rev_pfee}*(1-{usn})"
  },
  {
   "key": "l_total",
   "label": "Часов работы в месяц",
   "unit": "ч",
   "formula": "({mau}*0.02+{members}*0.1)*0.25+{partners}*3+{mau}*0.01*0.2+{l_content}+{ev_n}*12"
  },
  {
   "key": "fte",
   "label": "Людей на полный день (160 ч)",
   "unit": "чел",
   "formula": "{l_total}/160"
  }
 ]
