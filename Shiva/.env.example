# 1. Старый токен уже был раскрыт: сначала отзовите его у @BotFather.
# 2. Вставьте новый токен только сюда, в свой локальный файл .env.
TELEGRAM_BOT_TOKEN=PASTE_NEW_TOKEN_HERE
TELEGRAM_CHAT_ID=

# Mint Solana-токена из ссылки Stonkfun
TOKEN_MINT=3YhtPb2TTr671vg6zoStj2896sQoSSNBKyJzvzHQogib
TOKEN_SYMBOL=ВАШ_ТИКЕР

# Точный mint монеты пары SHIB — если он известен. Иначе оставьте пустым.
QUOTE_MINT=
QUOTE_SYMBOL=SHIB

# Минимум потраченного токена пары для сообщения. 0 = сообщать о каждой покупке.
MIN_BUY_AMOUNT=0

# Как часто проверять Solana. Публичный RPC может ограничивать запросы.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
POLL_INTERVAL_MS=15000
COMMITMENT=confirmed
MAX_SIGNATURE_PAGES=5

# Текст редактируется в файле message.html — здесь это менять не нужно.
MESSAGE_TEMPLATE_FILE=message.html

# Фото или GIF для объявления.
# Положите файл в папку media, например media/buy.jpg или media/buy.gif.
# Пустое значение = отправлять только текст.
MEDIA_FILE=
MEDIA_TYPE=auto
